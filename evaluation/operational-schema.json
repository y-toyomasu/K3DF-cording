  "prohibited_fields": ["task_body", "prompt", "command", "error", "host_path", "secret", "credential", "token", "flag", "authentication", "execution_secret", "private_reasoning"],
  "recommendation": {"comparison_class": "must match independently of experiment cohort", "experiment_cohort": "declared baseline or candidate value for exactly one axis", "minimum_quality_passing_samples_per_cohort": 3, "primary_metric": "wall_time_seconds", "secondary_metrics": ["retries", "reverification", "post_report_rework", "governance_violations"], "metric_direction": "lower_is_better", "change_candidate": "candidate median is strictly lower than baseline median", "retain": "candidate median is equal to or higher than baseline median", "more_data_required": ["fixed condition mismatch", "multiple axis change", "unknown configuration", "rubric mismatch", "calibration mismatch", "quality regression", "missing metric", "fewer than three quality-passing samples per cohort"], "default": "More Data Required"},
  "report": "reconstruct from validated allowlisted fields only and include experiment axis, fixed conditions, per-experiment cohort quality counts, metric samples, medians, and unavailable reasons"
